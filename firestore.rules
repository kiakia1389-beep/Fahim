rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // فقط این دو ایمیل می‌توانند بخوانند و بنویسند. ایمیل‌ها را با ایمیل‌های خودتان عوض کنید.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['EMAIL-1@example.com', 'EMAIL-2@example.com'];
    }
  }
}
